# Server
PORT=4000
NODE_ENV=development
PUBLIC_URL=http://localhost:4000

# MongoDB Atlas connection string
# Use public DNS if mongodb+srv fails (querySrv ESERVFAIL)
DNS_SERVERS=8.8.8.8,1.1.1.1

MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/lagid_connect

# LagID sandbox
# Base URL of the sandbox API (no trailing slash)
SANDBOX_BASE_URL=https://hackathon-api.dev.identikosharedsolutions.com
SANDBOX_API_KEY=
# true = use built-in mock residents instead of the sandbox
SANDBOX_MOCK=true
# Seconds to cache a lookup
SANDBOX_CACHE_TTL=60

# Hashing LagIDs before storing them (any long random string)
LAGID_HASH_SALT=change-me-to-a-long-random-string

# ES256 signing key, filled by `npm run keys`
SIGNING_KID=
SIGNING_PRIVATE_JWK=

# Show the one-time code in the app (the sandbox has no SMS)
DEMO_OTP=true
